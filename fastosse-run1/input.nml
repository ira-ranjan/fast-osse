&perfect_model_obs_nml
   single_file_in             = .false.,
   read_input_state_from_file = .true.,
   input_state_files          = "mom6.r.nc",
   init_time_days             = -1,
   init_time_seconds          = -1,

   single_file_out            = .false.,
   output_state_files         = "out_mom6.r.nc",
   write_output_state_to_file = .false.,
   output_interval            = 1,

   async                      = 0,
   adv_ens_command            = "./advance_model.csh",
   tasks_per_model_advance    = 1,

   obs_seq_in_file_name       = "obs_seq.in",
   obs_seq_out_file_name      = "obs_seq.out",
   first_obs_days             = -1,
   first_obs_seconds          = -1,
   last_obs_days              = -1,
   last_obs_seconds           = -1,
   obs_window_days            = -1,
   obs_window_seconds         = -1,

   trace_execution            = .trace.,
   output_timestamps          = .false.,
   print_every_nth_obs        = 0,
   output_forward_op_errors   = .false.,
   silence                    = .false.,
/

&algorithm_info_nml
    qceff_table_filename = ''
/

&assim_tools_nml
    adaptive_cutoff_floor = 0.0
    adaptive_localization_threshold = -1
    adjust_obs_impact = .false.
    allow_any_impact_values = .false.
    close_obs_caching = .true.
    convert_all_obs_verticals_first = .true.
    convert_all_state_verticals_first = .false.
    cutoff = 0.2
    distribute_mean = .false.
    gaussian_likelihood_tails = .false.
    localization_diagnostics_file = 'localization_diagnostics'
    obs_impact_filename = ''
    output_localization_diagnostics = .false.
    print_every_nth_obs = 0
    rectangular_quadrature = .true.
    sampling_error_correction = .false.
    sort_obs_inc = .true.
    special_localization_cutoffs = -888888
    special_localization_obs_types = 'null'
    spread_restoration = .false.
/

&cov_cutoff_nml
    select_localization = 1
/

&ensemble_manager_nml
    communication_configuration = 1
    debug = .false.
    layout = 2
    tasks_per_node = 128
/

&filter_nml
    allow_missing_clm = .false.
    compute_posterior = .true.
    distributed_state = .true.
    ens_size = 3
    first_obs_days = -1
    first_obs_seconds = -1
    inf_damping = 1.0, 1.0
    inf_deterministic = .true., .true.
    inf_flavor = 0, 0
    inf_initial = 1.0, 1.0
    inf_initial_from_restart = .true., .true.
    inf_lower_bound = 1.0, 1.0
    inf_sd_initial = 0.0, 0.0
    inf_sd_initial_from_restart = .true., .true.
    inf_sd_lower_bound = 0.0, 0.0
    inf_sd_max_change = 1.05, 1.05
    inf_upper_bound = 1000000.0, 1000000.0
    init_time_days = -1
    init_time_seconds = -1
    input_state_file_list = 'filter_input_list.txt'
    input_state_files = ''
    last_obs_days = -1
    last_obs_seconds = -1
    num_groups = 1
    num_output_obs_members = 3
    num_output_state_members = 0
    obs_sequence_in_name = 'obs_seq.out'
    obs_sequence_out_name = 'obs_seq.final'
    obs_window_days = -1
    obs_window_seconds = -1
    output_forward_op_errors = .false.
    output_interval = 1
    output_mean = .true.
    output_members = .true.
    output_sd = .true.
    output_state_file_list = 'filter_output_list.txt'
    output_state_files = ''
    output_timestamps = .false.
    perturb_from_single_instance = .false.
    perturbation_amplitude = 0.2
    silence = .false.
    single_file_in = .false.
    single_file_out = .false.
    stages_to_write = 'output    ', 'null      ', 'null      ', 'null      ', 'null      ', 'null      '
    trace_execution = .false.
    write_all_stages_at_end = .false.
    write_obs_every_cycle = .false.
/

&kde_nml
    quadrature_order = 9
/

&location_nml
    approximate_distance = .false.
    horiz_dist_only = .false.
    nlat = 36
    nlon = 71
    output_box_info = .false.
    print_box_level = 0
    special_vert_normalization_heights = -888888
    special_vert_normalization_levels = -888888
    special_vert_normalization_obs_types = 'null'
    special_vert_normalization_pressures = -888888
    special_vert_normalization_scale_heights = -888888
    vert_normalization_height = 10000.0
    vert_normalization_level = 20.0
    vert_normalization_pressure = 100000.0
    vert_normalization_scale_height = 5.0
/

&model_nml
    assimilation_period_days = 7
    assimilation_period_seconds = 0
    layer_name = 'z_l'
    model_state_variables = 'so ', 'QTY_SALINITY             ', 'NA', 'NA', 'UPDATE',
                            'thetao ', 'QTY_POTENTIAL_TEMPERATURE', 'NA', 'NA', 'UPDATE',
                            'uo    ', 'QTY_U_CURRENT_COMPONENT  ', 'NA', 'NA', 'UPDATE',
                            'vo    ', 'QTY_V_CURRENT_COMPONENT  ', 'NA', 'NA', 'UPDATE',
                            
    ocean_geometry = 'ocean_geometry.nc'
    static_file = 'mom6.static.nc'
    template_file = 'mom6.r.nc'
    use_pseudo_depth = .true.
    layer_name = 'z_l'
/

&mpi_utilities_nml
    all_tasks_print = .false.
    async2_verbose = .false.
    async4_verbose = .false.
    create_local_comm = .true.
    make_copy_before_broadcast = .false.
    make_copy_before_sendrecv = .false.
    reverse_task_layout = .false.
    separate_node_sync = .false.
    shell_name = ''
    verbose = .false.
/

&obs_kind_nml
    assimilate_these_obs_types = 'FLOAT_SALINITY', 'FLOAT_TEMPERATURE', 'DRIFTER_SALINITY', 'DRIFTER_TEMPERATURE', 'GLIDER_SALINITY', 'GLIDER_TEMPERATURE', 'MOORING_SALINITY', 'MOORING_TEMPERATURE', 'BOTTLE_SALINITY', 'BOTTLE_TEMPERATURE', 'CTD_SALINITY', 'CTD_TEMPERATURE', 'XCTD_SALINITY', 'XCTD_TEMPERATURE', 'XBT_TEMPERATURE', 'APB_TEMPERATURE', 'GLIDER_U_CURRENT_COMPONENT', 'GLIDER_V_CURRENT_COMPONENT' 
    evaluate_these_obs_types = 'null'
    use_precomputed_fos_these_obs_types = 'null'
/

&obs_sequence_nml
    read_binary_file_format = 'native'
    write_binary_obs_sequence = .false.
/

&probit_transform_nml
    do_inverse_check = .false.
    fix_bound_violations = .false.
    use_logit_instead_of_probit = .false.
/

&quad_interpolate_nml
    debug = 0
    do_rotate = .false.
/

&quality_control_nml
    enable_special_outlier_code = .false.
    input_qc_threshold = 3.0
    outlier_threshold = -1.0
/

&reg_factor_nml
    input_reg_file = 'time_mean_reg'
    reg_diagnostics_file = 'reg_diagnostics'
    save_reg_diagnostics = .false.
    select_regression = 1
/

&state_vector_io_nml
    buffer_state_io = .false.
    single_precision_output = .false.
/

&utilities_nml
    logfilename = 'dart_log.out'
    module_details = .false.
    nmlfilename = 'dart_log.nml'
    print_debug = .false.
    termlevel = 2
    write_nml = 'file'
/

